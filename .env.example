# true бол төхөөрөмж холбогдоогүй үед серверт загварчилсан (demo) өгөгдөл үүсгэнэ
SIMULATE=false

# ESP32 төхөөрөмж /api/ingest руу илгээхдээ "x-device-key" толгойд энэ түлхүүрийг дамжуулна
DEVICE_API_KEY=dev-secret-key

# (Ирээдүйд) Python ML үйлчилгээний хаяг. Хоосон бол серверийн дотоод baseline ангилагч ашиглана
ML_SERVICE_URL=http://127.0.0.1:8000

# (Ирээдүйд) Өгөгдлийн сан
DATABASE_URL=

# ---- Deploy (Vercel) ----
# Vercel → Storage → Upstash (Redis) нэмэхэд доорх 2 хувьсагч автоматаар орно.
# Эдгээр байвал сервер "үүлэн горим"-д ажиллана (төлөв Redis-д, веб 0.5 сек тутам шинэчлэгдэнэ).
KV_REST_API_URL=
KV_REST_API_TOKEN=
